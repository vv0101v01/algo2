// =============================================================================
// primary.mbt -- radicals and primary decomposition.
//
// Implemented, with proofs-turned-algorithms, in three complete regimes:
//  (A) Monomial ideals of any dimension: irreducible decomposition by the
//      coprime splitting lemma: if a generator is m = u*v with coprime
//      monomials u, v, then (J, uv) = (J, u) ∩ (J, v) -- checked on
//      monomials, where membership is divisibility. Leaves are generated
//      by pure powers (irreducible), then grouped by their radical, a
//      prime generated by variables.
//  (B) Univariate ideals: F_7[x] is a PID; factorization g = prod p_i^e_i
//      gives (g) = ∩ (p_i^e_i) with associated primes (p_i).
//  (C) Zero-dimensional ideals in any number of variables:
//      * radical via the trace form of the finite quotient algebra:
//        nilradical = { a | Tr(a*b) = 0 for all b } (valid over the
//        perfect field F_7, where the reduced quotient is separable);
//      * primality via: quotient is a field iff no nilpotents and the
//        Frobenius-fixed space { b | b^7 = b } is 1-dimensional
//        (it counts the field factors of a reduced finite algebra);
//      * splitting via a separator h: factor its minimal polynomial
//        mu_h = prod q_i into coprime prime powers; then
//        I = ∩ (I + (q_i(h))) since the (q_i(h)) are pairwise comaximal
//        and their product mu_h(h) lies in I. Recurse until each
//        component's radical is maximal (= prime), which for an Artinian
//        quotient is exactly primariness.
// General positive-dimensional non-monomial ideals return None: full
// GTZ primary decomposition is out of scope and is not simulated.
// =============================================================================

///|
pub fn Ideal::is_subset_of(self : Ideal, other : Ideal) -> Bool {
  for g in self.gens() {
    if !other.contains(g) {
      return false
    }
  }
  true
}

///|
pub fn Ideal::is_monomial_ideal(self : Ideal) -> Bool {
  for g in self.groebner() {
    if g.num_terms() != 1 {
      return false
    }
  }
  true
}

///|
fn mono_support(m : Mono) -> Array[Int32] {
  let s : Array[Int32] = []
  for i in 0..<m.num_vars() {
    if m.exp_at(i) > 0 {
      s.push(i)
    }
  }
  s
}

///|
/// Radical of a monomial ideal: replace each generator monomial by the
/// product of the variables in its support. None if not monomial.
pub fn Ideal::radical_of_monomial(self : Ideal) -> Ideal? {
  if !self.is_monomial_ideal() {
    return None
  }
  let gens : Array[Poly] = []
  for g in self.groebner() {
    let m = g.lead_mono()
    let e : Array[Int32] = []
    for i in 0..<m.num_vars() {
      e.push(if m.exp_at(i) > 0 { 1 } else { 0 })
    }
    gens.push(Poly::monomial(self.num_vars(), Fp::one(), e))
  }
  Some(Ideal::new(self.num_vars(), gens))
}

// -----------------------------------------------------------------------------
// Trace form, nilradical (zero-dimensional radical), field test.
// -----------------------------------------------------------------------------

///|
fn trace_of_elem(alg : FinAlg, x : FinElem) -> Fp {
  let m = alg.mult_matrix(x)
  let mut t = Fp::zero()
  for i in 0..<alg.dim() {
    t = t + m.get(i, i)
  }
  t
}

///|
/// Basis of the nilradical of a finite F_7-algebra via the trace form.
pub fn nilradical_basis(alg : FinAlg) -> Array[Array[Fp]] {
  let d = alg.dim()
  if d == 0 {
    return []
  }
  let rows : Array[Array[Fp]] = []
  for j in 0..<d {
    let row : Array[Fp] = []
    for i in 0..<d {
      row.push(
        trace_of_elem(alg, alg.mul(alg.basis_elem(j), alg.basis_elem(i))),
      )
    }
    rows.push(row)
  }
  span_basis(Matrix::from_rows(rows).nullspace())
}

///|
/// Is this finite F_7-algebra a field? Criteria proved in the header:
/// no nonzero nilpotents, and Frobenius-fixed space of dimension 1.
pub fn finite_algebra_is_field(alg : FinAlg) -> Bool {
  let d = alg.dim()
  if d == 0 {
    return false
  }
  if nilradical_basis(alg).length() > 0 {
    return false
  }
  // Matrix of (Frobenius - identity): column i is e_i^7 - e_i.
  let cols : Array[Array[Fp]] = []
  for i in 0..<d {
    cols.push(alg.pow(alg.basis_elem(i), PRIME).coords())
  }
  let rows : Array[Array[Fp]] = []
  for r in 0..<d {
    let row : Array[Fp] = []
    for i in 0..<d {
      let ident = if r == i { Fp::one() } else { Fp::zero() }
      row.push(cols[i][r] - ident)
    }
    rows.push(row)
  }
  Matrix::from_rows(rows).nullspace().length() == 1
}

///|
/// Radical of a zero-dimensional ideal: preimage of the nilradical of
/// R/I under the quotient map, nilradical computed by the trace form.
/// None if R/I is infinite-dimensional.
pub fn Ideal::radical_zero_dim(self : Ideal) -> Ideal? {
  let ring = QuotientRing::new(self)
  match QuotientModel::new(ring, "radical-model") {
    None => None
    Some(model) => {
      let basis = nilradical_basis(model.algebra())
      if basis.length() == 0 {
        return Some(self)
      }
      let gens : Array[Poly] = []
      for g in self.gens() {
        gens.push(g)
      }
      for v in basis {
        gens.push(model.to_coset(model.algebra().elem(v)).repr_poly())
      }
      Some(Ideal::new(self.num_vars(), gens))
    }
  }
}

///|
/// Primality test for zero-dimensional ideals: R/I is a (finite) field.
/// In dimension zero prime = maximal, so this is also the maximality
/// test. Non-zero-dimensional ideals return false here only in the
/// literal sense "not decided prime by this zero-dimensional test";
/// use it only where the name says.
pub fn Ideal::is_prime_zero_dim(self : Ideal) -> Bool {
  if self.is_unit_ideal() {
    return false
  }
  let ring = QuotientRing::new(self)
  match QuotientModel::new(ring, "prime-test-model") {
    None => false
    Some(model) => finite_algebra_is_field(model.algebra())
  }
}

///|
/// Primariness test for zero-dimensional ideals: the radical is prime
/// (maximal). For an Artinian quotient this is equivalent to primary:
/// the unique prime is nilpotent, containing all zero divisors.
pub fn Ideal::is_primary_zero_dim(self : Ideal) -> Bool {
  match self.radical_zero_dim() {
    None => false
    Some(rad) => rad.is_prime_zero_dim()
  }
}

// -----------------------------------------------------------------------------
// Primary decomposition data and verification.
// -----------------------------------------------------------------------------

///|
pub struct PrimaryComponent {
  component : Ideal
  prime : Ideal
}

///|
pub fn PrimaryComponent::component(self : PrimaryComponent) -> Ideal {
  self.component
}

///|
pub fn PrimaryComponent::prime(self : PrimaryComponent) -> Ideal {
  self.prime
}

///|
pub struct PrimaryDecomposition {
  components : Array[PrimaryComponent]
}

///|
pub fn PrimaryDecomposition::components(
  self : PrimaryDecomposition,
) -> Array[PrimaryComponent] {
  self.components
}

///|
pub fn PrimaryDecomposition::num_components(
  self : PrimaryDecomposition,
) -> Int32 {
  self.components.length()
}

///|
pub fn PrimaryDecomposition::associated_primes(
  self : PrimaryDecomposition,
) -> Array[Ideal] {
  let out : Array[Ideal] = []
  for c in self.components {
    let mut seen = false
    for p in out {
      if p.equal_to(c.prime) {
        seen = true
        break
      }
    }
    if !seen {
      out.push(c.prime)
    }
  }
  out
}

///|
/// Intersection of all components (unit ideal when the list is empty).
pub fn PrimaryDecomposition::intersection(
  self : PrimaryDecomposition,
  nvars : Int32,
) -> Ideal {
  if self.components.length() == 0 {
    return Ideal::unit_ideal(nvars)
  }
  let mut acc = self.components[0].component
  for i in 1..<self.components.length() {
    acc = acc.intersect(self.components[i].component)
  }
  acc
}

///|
/// Verify (for the regimes this library produces): intersection equals
/// the original ideal, each listed prime is the radical of its component
/// (monomial formula or zero-dimensional trace radical), and each prime
/// really is prime in the checkable sense (variable-generated primes for
/// monomial components; field quotients in zero dimension).
pub fn PrimaryDecomposition::verify(
  self : PrimaryDecomposition,
  ideal : Ideal,
) -> Bool {
  if !self.intersection(ideal.num_vars()).equal_to(ideal) {
    return false
  }
  for c in self.components {
    // radical(component) =?= prime, by whichever complete method applies
    let rad_ok = match c.component.radical_of_monomial() {
      Some(r) => r.equal_to(c.prime)
      None =>
        match c.component.radical_zero_dim() {
          Some(r) => r.equal_to(c.prime)
          None => false
        }
    }
    if !rad_ok {
      return false
    }
    // primality: variable primes are prime (quotient is a polynomial
    // ring); otherwise rely on the zero-dimensional field test.
    let prime_ok = is_variable_prime(c.prime) || c.prime.is_prime_zero_dim()
    if !prime_ok {
      return false
    }
  }
  true
}

///|
/// Is this ideal generated by a subset of the variables (hence prime,
/// with polynomial-ring quotient)?
fn is_variable_prime(ideal : Ideal) -> Bool {
  if ideal.is_zero_ideal() {
    return true
  }
  for g in ideal.groebner() {
    if g.num_terms() != 1 {
      return false
    }
    let m = g.lead_mono()
    if m.total_degree() != 1 {
      return false
    }
  }
  true
}

///|
fn dedupe_components(
  comps : Array[PrimaryComponent],
  original : Ideal,
) -> Array[PrimaryComponent] {
  // Remove exact duplicates first.
  let uniq : Array[PrimaryComponent] = []
  for c in comps {
    let mut seen = false
    for u in uniq {
      if c.component.equal_to(u.component) {
        seen = true
        break
      }
    }
    if !seen {
      uniq.push(c)
    }
  }
  // Irredundancy: drop any component whose absence does not change the
  // total intersection (checked against `original`).
  let mut kept = uniq
  let mut i = 0
  while i < kept.length() {
    let rest : Array[PrimaryComponent] = []
    for j in 0..<kept.length() {
      if j != i {
        rest.push(kept[j])
      }
    }
    let rest_decomp : PrimaryDecomposition = { components: rest, }
    if rest.length() > 0 &&
      rest_decomp.intersection(original.num_vars()).equal_to(original) {
      kept = rest
    } else {
      i = i + 1
    }
  }
  kept
}

// -----------------------------------------------------------------------------
// (A) Monomial primary decomposition.
// -----------------------------------------------------------------------------

///|
fn minimal_monos(monos : Array[Mono]) -> Array[Mono] {
  let out : Array[Mono] = []
  for i in 0..<monos.length() {
    let mut dominated = false
    for j in 0..<monos.length() {
      if i != j &&
        monos[j].divides(monos[i]) &&
        (!monos[j].equal_to(monos[i]) || j < i) {
        dominated = true
        break
      }
    }
    if !dominated {
      out.push(monos[i])
    }
  }
  out
}

///|
const MONOMIAL_PD_COMPONENT_LIMIT : Int32 = 512

///|
fn monomial_irreducible_rec(
  monos_in : Array[Mono],
  nvars : Int32,
  out : Array[Array[Mono]],
) -> Unit {
  if out.length() > MONOMIAL_PD_COMPONENT_LIMIT {
    abort("monomial primary decomposition: component limit exceeded")
  }
  let monos = minimal_monos(monos_in)
  // Constant generator: whole ring, represented as the empty-support leaf
  // whose ideal is (1); handled by caller via the monomial 1.
  for m in monos {
    if m.is_one() {
      out.push([Mono::one(nvars)])
      return
    }
  }
  // Find a generator supported on at least two variables.
  let mut split_index = -1
  for i in 0..<monos.length() {
    if mono_support(monos[i]).length() >= 2 {
      split_index = i
      break
    }
  }
  if split_index < 0 {
    out.push(monos)
    return
  }
  let m = monos[split_index]
  let support = mono_support(m)
  let v = support[0]
  let u = Mono::from_array(
    {
      let e : Array[Int32] = []
      for i in 0..<nvars {
        e.push(if i == v { m.exp_at(i) } else { 0 })
      }
      e
    },
  )
  let rest = Mono::quotient(m, u)
  let branch_u : Array[Mono] = []
  let branch_v : Array[Mono] = []
  for i in 0..<monos.length() {
    if i == split_index {
      branch_u.push(u)
      branch_v.push(rest)
    } else {
      branch_u.push(monos[i])
      branch_v.push(monos[i])
    }
  }
  monomial_irreducible_rec(branch_u, nvars, out)
  monomial_irreducible_rec(branch_v, nvars, out)
}

///|
/// Primary decomposition of a monomial ideal. None if the ideal is not
/// monomial.
pub fn primary_decomposition_monomial(ideal : Ideal) -> PrimaryDecomposition? {
  if !ideal.is_monomial_ideal() {
    return None
  }
  if ideal.is_unit_ideal() {
    return Some({ components: [], })
  }
  let n = ideal.num_vars()
  let start : Array[Mono] = []
  for g in ideal.groebner() {
    start.push(g.lead_mono())
  }
  let leaves : Array[Array[Mono]] = []
  monomial_irreducible_rec(start, n, leaves)
  // Leaves to irreducible ideals; group by radical (support prime).
  let groups : Array[(Ideal, Array[Ideal])] = []
  for leaf in leaves {
    let gens : Array[Poly] = []
    for m in leaf {
      let e : Array[Int32] = []
      for i in 0..<n {
        e.push(m.exp_at(i))
      }
      gens.push(Poly::monomial(n, Fp::one(), e))
    }
    let leaf_ideal = Ideal::new(n, gens)
    let rad = match leaf_ideal.radical_of_monomial() {
      Some(r) => r
      None => abort("monomial leaf radical failed (bug)")
    }
    let mut placed = false
    for (prime, members) in groups {
      if prime.equal_to(rad) {
        members.push(leaf_ideal)
        placed = true
        break
      }
    }
    if !placed {
      groups.push((rad, [leaf_ideal]))
    }
  }
  let comps : Array[PrimaryComponent] = []
  for (prime, members) in groups {
    let mut acc = members[0]
    for i in 1..<members.length() {
      acc = acc.intersect(members[i])
    }
    comps.push({ component: acc, prime, })
  }
  let result : PrimaryDecomposition = {
    components: dedupe_components(comps, ideal),
  }
  if !result.intersection(n).equal_to(ideal) {
    abort("monomial primary decomposition: intersection mismatch (bug)")
  }
  Some(result)
}

// -----------------------------------------------------------------------------
// (B) Univariate primary decomposition.
// -----------------------------------------------------------------------------

///|
pub fn primary_decomposition_univariate(ideal : Ideal) -> PrimaryDecomposition? {
  if ideal.num_vars() != 1 {
    return None
  }
  if ideal.is_unit_ideal() {
    return Some({ components: [], })
  }
  if ideal.is_zero_ideal() {
    return Some({ components: [{ component: ideal, prime: ideal, }], })
  }
  // F_7[x] is a PID: reduced Groebner basis is a single generator.
  let g = ideal.groebner()[0]
  let comps : Array[PrimaryComponent] = []
  for fc in factor_univariate(g) {
    comps.push({
      component: Ideal::new(1, [fc.factor().pow(fc.exponent())]),
      prime: Ideal::new(1, [fc.factor()]),
    })
  }
  Some({ components: comps, })
}

// -----------------------------------------------------------------------------
// (C) Zero-dimensional primary decomposition by separator splitting.
// -----------------------------------------------------------------------------

///|
fn pd_zero_rec(ideal : Ideal, out : Array[PrimaryComponent], rng : Rng) -> Bool {
  if ideal.is_unit_ideal() {
    return true
  }
  let rad = match ideal.radical_zero_dim() {
    Some(r) => r
    None => return false
  }
  if rad.is_prime_zero_dim() {
    out.push({ component: ideal, prime: rad, })
    return true
  }
  let n = ideal.num_vars()
  let ring = QuotientRing::new(ideal)
  let model = match QuotientModel::new(ring, "pd-model") {
    Some(m) => m
    None => return false
  }
  let my_dim = model.algebra().dim()
  // Candidate separators: variables, then random small polynomials.
  let candidates : Array[Poly] = []
  for i in 0..<n {
    candidates.push(Poly::variable(n, i))
  }
  for _ in 0..<240 {
    candidates.push(Poly::pseudo_random(rng, n, 3, 2))
  }
  for h in candidates {
    let elem = model.to_elem(ring.of_poly(h))
    let mu = minimal_polynomial_of_elem(model, elem)
    if mu.total_degree() <= 1 {
      continue
    }
    let factors = factor_univariate(mu)
    if factors.length() < 2 {
      continue
    }
    let comps : Array[Ideal] = []
    let mut dims_sum = 0
    let mut usable = true
    for fc in factors {
      let q_at_h = fc.factor().pow(fc.exponent()).compose([h])
      let comp = ideal.sum(Ideal::new(n, [q_at_h]))
      if comp.is_unit_ideal() {
        continue
      }
      match comp.finite_dimension() {
        Some(d) =>
          if d == 0 || d >= my_dim {
            usable = false
          } else {
            dims_sum = dims_sum + d
            comps.push(comp)
          }
        None => usable = false
      }
      if !usable {
        break
      }
    }
    if !usable || comps.length() < 2 || dims_sum != my_dim {
      continue
    }
    // Certify the split before recursing: comaximality + product in I
    // should force the intersection back to I; if not, something is
    // mathematically wrong with this run and we say so loudly.
    let mut inter = comps[0]
    for i in 1..<comps.length() {
      inter = inter.intersect(comps[i])
    }
    if !inter.equal_to(ideal) {
      abort("zero-dimensional splitting did not recompose (bug)")
    }
    for comp in comps {
      if !pd_zero_rec(comp, out, rng) {
        return false
      }
    }
    return true
  }
  false
}

///|
/// Primary decomposition of a zero-dimensional ideal. None when the
/// quotient is infinite-dimensional, or when the bounded separator
/// search fails (reported, never papered over with a guessed answer).
pub fn primary_decomposition_zero_dim(ideal : Ideal) -> PrimaryDecomposition? {
  match ideal.finite_dimension() {
    None => return None
    Some(_) => ()
  }
  if ideal.is_unit_ideal() {
    return Some({ components: [], })
  }
  let rng = Rng::new(20261018)
  let out : Array[PrimaryComponent] = []
  if !pd_zero_rec(ideal, out, rng) {
    return None
  }
  let result : PrimaryDecomposition = {
    components: dedupe_components(out, ideal),
  }
  if !result.intersection(ideal.num_vars()).equal_to(ideal) {
    abort("zero-dimensional primary decomposition mismatch (bug)")
  }
  Some(result)
}

///|
/// Best available primary decomposition: monomial (any dimension), else
/// univariate, else zero-dimensional. None outside these regimes --
/// see the file header for exactly what is and is not claimed.
pub fn primary_decomposition(ideal : Ideal) -> PrimaryDecomposition? {
  match primary_decomposition_monomial(ideal) {
    Some(d) => return Some(d)
    None => ()
  }
  match primary_decomposition_univariate(ideal) {
    Some(d) => return Some(d)
    None => ()
  }
  primary_decomposition_zero_dim(ideal)
}

///|
/// Radical via primary decomposition when available:
/// sqrt(I) = intersection of the associated primes.
pub fn Ideal::radical_via_decomposition(self : Ideal) -> Ideal? {
  match primary_decomposition(self) {
    None => None
    Some(d) => {
      let primes = d.associated_primes()
      if primes.length() == 0 {
        return Some(Ideal::unit_ideal(self.num_vars()))
      }
      let mut acc = primes[0]
      for i in 1..<primes.length() {
        acc = acc.intersect(primes[i])
      }
      Some(acc)
    }
  }
}
